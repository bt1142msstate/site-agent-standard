{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bt1142msstate/site-agent-standard/raw/main/spec/0.2/schemas/query.schema.json",
  "$defs": {
    "resource": {
      "type": "object",
      "required": ["id", "description", "visibility", "execution", "modes", "filters", "resultSchema", "pagination", "freshness"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 8 },
        "aliases": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "keywords": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
        "examples": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 3, "maxLength": 240 } },
        "visibility": { "enum": ["public", "authenticated"] },
        "permissionsAll": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "permissionsAny": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "status": { "enum": ["active", "deprecated", "sunset"] },
        "replacedBy": { "type": "string" },
        "sunsetAt": { "type": "string", "format": "date-time" },
        "execution": { "enum": ["local", "host"] },
        "modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "filters": { "type": "object", "additionalProperties": { "type": "object" } },
        "sorts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "maxResults": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "resultSchema": { "type": "object" },
        "pagination": {
          "type": "object",
          "required": ["style"],
          "properties": {
            "style": { "enum": ["none", "cursor"] },
            "defaultLimit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "maxLimit": { "type": "integer", "minimum": 1, "maximum": 1000 }
          },
          "additionalProperties": false
        },
        "freshness": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["static", "snapshot", "live"] },
            "maxAgeSeconds": { "type": "integer", "minimum": 0 },
            "eventIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "materialization": {
          "type": "object",
          "required": ["basis", "stage", "surfaceParity", "nestedContent", "nestedDestination"],
          "properties": {
            "basis": { "enum": ["rendered-user-surface", "canonical-structured-source", "document-text", "external"] },
            "stage": { "enum": ["build", "runtime", "request"] },
            "surfaceParity": { "enum": ["required", "not-applicable"] },
            "nestedContent": { "enum": ["resolved", "not-applicable"] },
            "nestedDestination": { "enum": ["exact-reveal-required", "not-applicable"] }
          },
          "additionalProperties": false
        },
        "aggregations": { "type": "object", "additionalProperties": { "type": "object" } },
        "relationships": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "destinationId": { "type": "string" },
        "resultTargetKind": { "type": "string", "minLength": 1 }
      },
      "patternProperties": { "^x-[a-z0-9._-]+$": true },
      "allOf": [
        {
          "if": {
            "properties": {
              "execution": { "const": "local" },
              "freshness": { "type": "object", "properties": { "mode": { "const": "static" } }, "required": ["mode"] }
            },
            "required": ["execution", "freshness"]
          },
          "then": { "properties": { "materialization": {} }, "required": ["materialization"] }
        },
        {
          "if": {
            "properties": {
              "materialization": { "type": "object", "properties": { "basis": { "const": "rendered-user-surface" } }, "required": ["basis"] }
            },
            "required": ["materialization"]
          },
          "then": {
            "properties": {
              "materialization": {
                "type": "object",
                "properties": {
                  "surfaceParity": { "const": "required" },
                  "nestedContent": { "const": "resolved" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "materialization": {
                "type": "object",
                "properties": { "nestedDestination": { "const": "exact-reveal-required" } },
                "required": ["nestedDestination"]
              }
            },
            "required": ["materialization"]
          },
          "then": {
            "properties": { "destinationId": { "type": "string" } },
            "required": ["destinationId"]
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
