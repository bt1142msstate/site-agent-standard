{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bt1142msstate/site-agent-standard/raw/main/spec/0.2/schemas/action.schema.json",
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id", "description", "visibility", "risk", "confirmation", "inputSchema", "outputSchema", "reconciliation", "taskSupport", "sideEffects"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 8 },
        "visibility": { "enum": ["public", "authenticated"] },
        "permissionsAll": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "permissionsAny": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "status": { "enum": ["active", "deprecated", "sunset"] },
        "replacedBy": { "type": "string" },
        "sunsetAt": { "type": "string", "format": "date-time" },
        "risk": { "enum": ["read", "reversible", "consequential", "destructive"] },
        "confirmation": { "enum": ["none", "explicit", "typed"] },
        "confirmationSchema": { "type": "object" },
        "reconciliation": {
          "type": "object",
          "required": ["identity", "equivalent", "nonConflicting", "conflicting", "missing"],
          "properties": {
            "identity": { "const": "stable-reference" },
            "equivalent": { "const": "complete" },
            "nonConflicting": { "enum": ["rebase", "reconfirm"] },
            "conflicting": { "enum": ["reconfirm", "reject"] },
            "missing": { "enum": ["complete-if-satisfied", "reconfirm", "reject"] }
          },
          "additionalProperties": false
        },
        "inputSchema": { "type": "object" },
        "outputSchema": { "type": "object" },
        "taskSupport": { "enum": ["forbidden", "optional", "required"] },
        "sideEffects": { "type": "array", "uniqueItems": true, "items": { "enum": ["none", "data", "notification", "file", "financial", "identity", "external"] } },
        "openWorld": { "type": "boolean" },
        "destinationId": { "type": "string" }
      },
      "patternProperties": { "^x-[a-z0-9._-]+$": true },
      "additionalProperties": false
    }
  }
}
