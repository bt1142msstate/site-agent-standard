{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bt1142msstate/site-agent-standard/raw/main/spec/0.2/schemas/manifest.schema.json",
  "title": "Site Agent manifest 0.2",
  "type": "object",
  "required": ["standardVersion", "manifestVersion", "capabilityRevision", "id", "name", "profiles", "queryResources", "navigationDestinations", "actions"],
  "properties": {
    "$schema": { "type": "string" },
    "standardVersion": { "const": "0.2" },
    "manifestVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "capabilityRevision": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "profiles": {
      "type": "array",
      "uniqueItems": true,
      "contains": { "const": "core" },
      "items": { "enum": ["core", "query", "navigation", "action", "presentation", "operability"] }
    },
    "queryResources": { "type": "array", "items": { "$ref": "query.schema.json#/$defs/resource" } },
    "navigationDestinations": { "type": "array", "items": { "$ref": "navigation.schema.json#/$defs/destination" } },
    "actions": { "type": "array", "items": { "$ref": "action.schema.json#/$defs/action" } },
    "presentation": {
      "type": "object",
      "required": ["preset", "cursor", "cursorMotion", "frameTarget", "clickFeedback", "clickSound", "scrollMotion", "inputPresentation", "typingSound", "responsiveVariants", "supportedThemes", "visualQuality", "muteSupported", "reducedMotionSupported"],
      "properties": {
        "preset": { "type": "string", "minLength": 1 },
        "cursor": { "type": "string", "minLength": 1 },
        "cursorMotion": { "type": "string", "minLength": 1 },
        "frameTarget": { "type": "string", "minLength": 1 },
        "clickFeedback": { "type": "string", "minLength": 1 },
        "clickSound": { "type": "string", "minLength": 1 },
        "scrollMotion": { "type": "string", "minLength": 1 },
        "inputPresentation": { "type": "string", "minLength": 1 },
        "typingSound": { "type": "string", "minLength": 1 },
        "responsiveVariants": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["desktop", "tablet", "mobile"] } },
        "supportedThemes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }
        },
        "visualQuality": {
          "type": "object",
          "required": ["source", "mappedStates", "viewports", "themes", "visibleLabels", "contrast"],
          "properties": {
            "source": { "const": "browser-computed-style" },
            "mappedStates": { "const": "all" },
            "viewports": { "const": "all-responsive-variants" },
            "themes": { "const": "all-supported" },
            "visibleLabels": { "const": "required" },
            "contrast": { "const": "wcag-2.2-aa" }
          },
          "additionalProperties": false
        },
        "muteSupported": { "const": true },
        "reducedMotionSupported": { "const": true }
      },
      "additionalProperties": false
    },
    "operability": {
      "type": "object",
      "required": ["evidenceSource", "coverage", "viewports", "inputModes", "accessibilityRules", "wcagConformanceClaim", "navigationBudgetMs", "queryBudgetMs"],
      "properties": {
        "evidenceSource": { "const": "independent-operability-run" },
        "coverage": { "const": "all-active-capabilities" },
        "viewports": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "contains": { "const": "desktop" },
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" }
        },
        "inputModes": {
          "type": "array",
          "uniqueItems": true,
          "allOf": [{ "contains": { "const": "keyboard" } }, { "contains": { "const": "programmatic" } }],
          "items": { "enum": ["keyboard", "pointer", "touch", "programmatic", "assistive-technology"] }
        },
        "accessibilityRules": { "const": "act-compatible-automated-and-manual" },
        "wcagConformanceClaim": { "const": false },
        "navigationBudgetMs": { "type": "integer", "minimum": 100, "maximum": 30000 },
        "queryBudgetMs": { "type": "integer", "minimum": 50, "maximum": 30000 }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "visibility", "payloadSchema"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "minLength": 8 },
          "visibility": { "enum": ["public", "authenticated"] },
          "permissionsAll": { "type": "array", "items": { "type": "string" } },
          "permissionsAny": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["active", "deprecated", "sunset"] },
          "replacedBy": { "type": "string" },
          "sunsetAt": { "type": "string", "format": "date-time" },
          "payloadSchema": { "type": "object" }
        },
        "patternProperties": { "^x-[a-z0-9._-]+$": true },
        "additionalProperties": false
      }
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "visibility", "steps"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string", "minLength": 8 },
          "visibility": { "enum": ["public", "authenticated"] },
          "permissionsAll": { "type": "array", "items": { "type": "string" } },
          "permissionsAny": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["active", "deprecated", "sunset"] },
          "replacedBy": { "type": "string" },
          "sunsetAt": { "type": "string", "format": "date-time" },
          "actors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "role"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
                "role": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "contexts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "actorId", "kind"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
                "actorId": { "type": "string" },
                "kind": { "enum": ["client", "operations"] }
              },
              "additionalProperties": false
            }
          },
          "synchronization": {
            "type": "object",
            "required": ["timeline", "barriers", "recording"],
            "properties": {
              "timeline": { "const": "shared-monotonic" },
              "barriers": { "const": "step-boundaries" },
              "recording": { "const": "all-contexts" }
            },
            "additionalProperties": false
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "capabilityId"],
              "properties": {
                "id": { "type": "string" },
                "capabilityId": { "type": "string" },
                "actorId": { "type": "string" },
                "contextId": { "type": "string" },
                "dependsOn": { "type": "array", "items": { "type": "string" } },
                "onSuccess": { "type": "string" },
                "onFailure": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "properties": { "actors": {} }, "required": ["actors"] },
                { "properties": { "contexts": {} }, "required": ["contexts"] },
                { "properties": { "synchronization": {} }, "required": ["synchronization"] }
              ]
            },
            "then": { "required": ["actors", "contexts", "synchronization"] }
          }
        ],
        "patternProperties": { "^x-[a-z0-9._-]+$": true },
        "additionalProperties": false
      }
    },
    "bindings": { "type": "object" },
    "conformance": {
      "type": "object",
      "properties": {
        "claims": { "type": "array", "uniqueItems": true, "items": { "enum": ["core", "query", "navigation", "action", "presentation", "operability"] } },
        "coverage": {
          "type": "object",
          "properties": {
            "visibleSurfaces": { "enum": ["complete", "partial"] },
            "humanActions": { "enum": ["complete", "partial"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": { "^x-[a-z0-9._-]+$": true },
  "allOf": [
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "presentation" } } } },
      "then": { "properties": { "presentation": {} }, "required": ["presentation"] }
    },
    {
      "if": { "properties": { "profiles": { "type": "array", "contains": { "const": "operability" } } } },
      "then": { "properties": { "operability": {} }, "required": ["operability"] }
    }
  ],
  "additionalProperties": false
}
