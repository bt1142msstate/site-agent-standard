{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bt1142msstate/site-agent-standard/raw/main/spec/0.1/schemas/action.schema.json",
  "$defs": {
    "action": {
      "type": "object",
      "required": ["id", "description", "visibility", "risk", "confirmation", "inputSchema", "reconciliation"],
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string", "minLength": 8 },
        "visibility": { "enum": ["public", "authenticated"] },
        "permissionsAll": { "type": "array", "items": { "type": "string" } },
        "permissionsAny": { "type": "array", "items": { "type": "string" } },
        "risk": { "enum": ["read", "reversible", "consequential", "destructive"] },
        "confirmation": { "enum": ["none", "explicit", "typed"] },
        "reconciliation": {
          "type": "object",
          "required": ["identity", "equivalent", "nonConflicting", "conflicting", "missing"],
          "properties": {
            "identity": { "const": "stable-reference" },
            "equivalent": { "const": "complete" },
            "nonConflicting": { "enum": ["rebase", "reconfirm"] },
            "conflicting": { "enum": ["reconfirm", "reject"] },
            "missing": { "enum": ["complete-if-satisfied", "reconfirm", "reject"] }
          },
          "additionalProperties": false
        },
        "inputSchema": { "type": "object" },
        "destinationId": { "type": "string" }
      },
      "patternProperties": { "^x-[a-z0-9._-]+$": true },
      "additionalProperties": false
    }
  }
}
