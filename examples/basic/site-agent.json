{
  "$schema": "../../spec/0.2/schemas/manifest.schema.json",
  "standardVersion": "0.2",
  "manifestVersion": "1.0.0",
  "capabilityRevision": "example-orders-1",
  "id": "example.orders",
  "name": "Example order site",
  "profiles": ["core", "query", "navigation", "action", "presentation"],
  "presentation": {
    "preset": "standard-instructional-v2",
    "cursor": "modern-stemless-pointer",
    "cursorMotion": "travel-pause-click",
    "frameTarget": "settled-sticky-header-aware",
    "clickFeedback": "target-outline-and-ripple",
    "clickSound": "soft-tactile-ui-click-v1",
    "scrollMotion": "tutorial-eased-nested-scroll-v1",
    "inputPresentation": "visible-typing-with-keystroke-audio",
    "typingSound": "ios-inspired-mobile-keyboard-tap-v1",
    "responsiveVariants": ["desktop", "mobile"],
    "muteSupported": true,
    "reducedMotionSupported": true
  },
  "queryResources": [
    {
      "id": "orders",
      "description": "Permission-scoped example orders and their current status",
      "visibility": "authenticated",
      "permissionsAll": ["orders.view"],
      "execution": "host",
      "modes": ["records", "count", "summary"],
      "filters": {
        "query": { "type": "string" },
        "status": { "type": "string" },
        "period": { "type": "string" }
      },
      "sorts": ["newest", "oldest"],
      "maxResults": 50,
      "pagination": { "style": "cursor", "defaultLimit": 25, "maxLimit": 50 },
      "freshness": { "mode": "snapshot", "maxAgeSeconds": 30 },
      "resultSchema": {
        "type": "object",
        "required": ["items", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["reference", "label", "fields"],
              "properties": {
                "reference": { "type": "string" },
                "label": { "type": "string" },
                "fields": { "type": "object" }
              },
              "additionalProperties": true
            }
          },
          "total": { "type": "integer", "minimum": 0 },
          "summary": { "type": "string" },
          "nextCursor": { "type": "string" },
          "asOf": { "type": "string" }
        },
        "additionalProperties": true
      },
      "destinationId": "orders.detail"
    }
  ],
  "navigationDestinations": [
    {
      "id": "orders.detail",
      "description": "Open the requested order state and focus its exact record",
      "visibility": "authenticated",
      "permissionsAll": ["orders.view"],
      "route": "/orders/",
      "precision": "record",
      "exact": true,
      "targetKinds": ["order"],
      "targetSelection": {
        "order": ["record", "text"],
        "oversized": "next-declared-candidate",
        "requireFullyVisible": true,
        "inferredDomFallback": false
      },
      "stateSchema": {
        "type": "object",
        "properties": { "period": { "type": "string" }, "status": { "type": "string" } },
        "additionalProperties": false
      }
    }
  ],
  "actions": [
    {
      "id": "orders.archive",
      "description": "Archive one reviewed order through the site's authoritative handler",
      "visibility": "authenticated",
      "permissionsAll": ["orders.manage"],
      "risk": "consequential",
      "confirmation": "explicit",
      "reconciliation": {
        "identity": "stable-reference",
        "equivalent": "complete",
        "nonConflicting": "rebase",
        "conflicting": "reconfirm",
        "missing": "complete-if-satisfied"
      },
      "inputSchema": {
        "type": "object",
        "required": ["orderReference"],
        "properties": { "orderReference": { "type": "string" } },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "required": ["archived"],
        "properties": { "archived": { "type": "boolean" } },
        "additionalProperties": false
      },
      "taskSupport": "forbidden",
      "sideEffects": ["data"],
      "destinationId": "orders.detail"
    }
  ],
  "events": [
    {
      "id": "orders.changed",
      "description": "Signals that an authorized order projection changed",
      "visibility": "authenticated",
      "permissionsAll": ["orders.view"],
      "payloadSchema": {
        "type": "object",
        "required": ["reference"],
        "properties": { "reference": { "type": "string" } },
        "additionalProperties": false
      }
    }
  ],
  "workflows": [
    {
      "id": "orders.review-and-archive",
      "description": "Review an order and archive it after explicit confirmation",
      "visibility": "authenticated",
      "permissionsAll": ["orders.manage"],
      "steps": [
        { "id": "find", "capabilityId": "orders" },
        { "id": "show", "capabilityId": "orders.detail", "dependsOn": ["find"] },
        { "id": "archive", "capabilityId": "orders.archive", "dependsOn": ["show"] }
      ]
    }
  ],
  "bindings": {
    "mcp": { "enabled": true },
    "webmcp": { "enabled": true },
    "arazzo": { "enabled": true },
    "asyncapi": { "enabled": true }
  },
  "conformance": {
    "claims": ["core", "query", "navigation", "action"],
    "coverage": { "visibleSurfaces": "complete", "humanActions": "complete" }
  }
}
