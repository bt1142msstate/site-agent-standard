{
  "name": "@bt1142msstate/site-agent-standard",
  "version": "0.15.0",
  "description": "A transport-neutral standard and reference runtime for permission-scoped query, verified navigation, safe actions, and instructional presentation.",
  "type": "module",
  "main": "./src/site-agent.js",
  "types": "./src/site-agent.d.ts",
  "bin": {
    "site-agent": "bin/site-agent.js"
  },
  "exports": {
    ".": {
      "types": "./src/site-agent.d.ts",
      "import": "./src/site-agent.js"
    },
    "./navigation": {
      "types": "./src/site-navigator.d.ts",
      "import": "./src/site-navigator.js"
    },
    "./manifest": {
      "types": "./src/site-agent.d.ts",
      "import": "./src/manifest.js"
    },
    "./bindings": {
      "types": "./src/bindings.d.ts",
      "import": "./src/bindings.js"
    },
    "./conformance": {
      "types": "./src/conformance.d.ts",
      "import": "./src/conformance.js"
    },
    "./problems": {
      "types": "./src/problem.d.ts",
      "import": "./src/problem.js"
    },
    "./execution": {
      "types": "./src/execution.d.ts",
      "import": "./src/execution.js"
    },
    "./coverage": {
      "types": "./src/coverage.d.ts",
      "import": "./src/coverage.js"
    },
    "./operability": {
      "types": "./src/operability.d.ts",
      "import": "./src/operability.js"
    },
    "./presentation": {
      "types": "./src/presentation.d.ts",
      "import": "./src/presentation.js"
    },
    "./presentation-audio": {
      "types": "./src/presentation-audio.d.ts",
      "import": "./src/presentation-audio.js"
    },
    "./rendered-quality": {
      "types": "./src/rendered-quality.d.ts",
      "import": "./src/rendered-quality.js"
    },
    "./artifact-contract": {
      "types": "./src/artifact-contract.d.ts",
      "import": "./src/artifact-contract.js"
    },
    "./tutorial-runtime": {
      "types": "./src/tutorial-runtime.d.ts",
      "import": "./src/tutorial-runtime.js"
    },
    "./presentation-contract": {
      "import": "./src/presentation-contract.cjs",
      "require": "./src/presentation-contract.cjs"
    },
    "./presentation.css": "./src/presentation.css",
    "./navigation-progress.css": "./src/navigation-progress.css",
    "./schemas/manifest": "./spec/0.2/schemas/manifest.schema.json",
    "./schemas/query": "./spec/0.2/schemas/query.schema.json",
    "./schemas/navigation": "./spec/0.2/schemas/navigation.schema.json",
    "./schemas/action": "./spec/0.2/schemas/action.schema.json",
    "./schemas/manifest-0.1": "./spec/0.1/schemas/manifest.schema.json",
    "./schemas/query-0.1": "./spec/0.1/schemas/query.schema.json",
    "./schemas/navigation-0.1": "./spec/0.1/schemas/navigation.schema.json",
    "./schemas/action-0.1": "./spec/0.1/schemas/action.schema.json"
  },
  "files": [
    "bin",
    "docs",
    "src",
    "spec",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:conformance": "node ./bin/site-agent.js test ./examples/basic/site-agent.json --adapter ./examples/basic/conformance.mjs",
    "check": "npm run test && npm run test:conformance && npm run test:browser"
  },
  "keywords": [
    "agent",
    "ai",
    "standard",
    "query",
    "actions",
    "navigation",
    "presentation",
    "tutorials",
    "accessibility",
    "automation",
    "scroll",
    "shadow-dom",
    "testing"
  ],
  "author": "Brandon Temple",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bt1142msstate/site-agent-standard.git"
  },
  "bugs": {
    "url": "https://github.com/bt1142msstate/site-agent-standard/issues"
  },
  "homepage": "https://github.com/bt1142msstate/site-agent-standard#readme",
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2"
  },
  "engines": {
    "node": ">=20"
  }
}
